# ---------------------------------------------------------------------------
# Copy this file to backend/.env (and frontend/.env for the VITE_* values).
# ---------------------------------------------------------------------------

# --- Core application ------------------------------------------------------
APP_NAME=ToyBox                          # Display name used in API metadata
ENVIRONMENT=development                  # development | production
DEBUG=true                               # Enables verbose errors and API docs

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./app.db          # SQLAlchemy URL. Relative to /backend

# --- Security / JWT --------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string   # HMAC secret for signing JWTs
JWT_ALGORITHM=HS256                                # JWT signing algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=30                     # Access token lifetime (minutes)
REFRESH_TOKEN_EXPIRE_DAYS=7                        # Refresh token lifetime (days)

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # Comma-separated frontend origins

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=static/uploads                # Local disk folder for product images
MAX_UPLOAD_BYTES=5242880                 # Max product image size (5 MB)

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx            # Stripe test-mode secret key (blank = dev payment mode)
STRIPE_WEBHOOK_SECRET=whsec_xxx          # Signing secret printed by `stripe listen`
STRIPE_CURRENCY=usd                      # ISO currency code for Checkout Sessions
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success   # Stripe success redirect
CHECKOUT_CANCEL_URL=http://localhost:5173/checkout/cancel     # Stripe cancel redirect
ALLOW_DEV_PAYMENT=true                   # Allow /checkout/dev-confirm when Stripe keys are absent

# --- Storefront pricing ----------------------------------------------------
SHIPPING_FLAT_CENTS=599                  # Flat shipping fee in cents
FREE_SHIPPING_THRESHOLD_CENTS=5000       # Order subtotal (cents) above which shipping is free
TAX_RATE_BPS=663                         # Sales tax in basis points (663 = 6.63%, NJ)

# --- Frontend (put these in frontend/.env) ---------------------------------
VITE_API_BASE_URL=http://localhost:8000  # Base URL of the FastAPI backend
